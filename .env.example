# Server-side Supabase. The service role key is server-only; it is never
# shipped to a browser bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-side Supabase auth (the OAuth sign-in page uses these, not the
# service role key). The publishable (anon) key can authenticate but cannot
# read the catalog: anonymous reads are removed at the database layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Numeric GitHub ids allowed to read the catalog, comma-separated. An empty or
# missing value denies everyone (fail-closed).
LINERFY_ALLOWED_GITHUB_IDS=

# Dedicated bearer token for POST /api/service/context. Grant only to Pox;
# keep it distinct from Supabase and worker credentials. Empty disables access.
LINERFY_POX_SERVICE_TOKEN=

# Shared secret protecting the deployable Python worker function (the Worker
# Vercel Project, POST /api/enrichment at ingest/api/enrichment.py). Supabase
# Cron invokes it once a minute with this bearer token, which is also stored in
# Supabase Vault and never committed. Leave empty to disable the worker (503).
LINERFY_WORKER_SECRET=

# Worker database connection. Prefer the Supabase Session pooler when the
# runtime must preserve PostgreSQL session semantics across a connection.
DATABASE_URL=

# Desktop app (Electron main) GitHub OAuth. The main process reads SUPABASE_URL
# and SUPABASE_PUBLISHABLE_KEY (the anon key) to run the PKCE flow; the session
# token is encrypted with the OS keychain and never reaches the renderer. The
# loopback redirect URL below must be added to Supabase Auth's redirect allow
# list:  http://127.0.0.1:4862/callback
LINERFY_OAUTH_REDIRECT_PORT=4862

# Base URL of the deployed web API (e.g. https://<project>.vercel.app). The
# desktop main process POSTs the now-playing track here to read its context.
# Context fetching stays disabled until this and a session are present.
LINERFY_API_URL=

# Local integration-test guards. Do not configure these in Vercel or another
# production environment. Set them inline only for an isolated test database.
LINERFY_RESET_ALLOWED=
LINERFY_DB_TESTS_ALLOWED=

# Model provider for the summary step. `MODEL_PROTOCOL` is one of
# `openai-compatible` (DeepSeek/OpenAI) or `anthropic` (Claude). Only one
# provider is active at a time; there is no automatic fallback.
MODEL_PROTOCOL=openai-compatible
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_MAX_TOKENS=2048
